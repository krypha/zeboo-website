# public origin of this site: every canonical url, hreflang link and sitemap entry is built on it
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# the web app the doors open onto (signing in, signing up); zeboo-frontend runs on 3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# the token google search console asks for when the domain is claimed; leave empty until then
GOOGLE_SITE_VERIFICATION=
